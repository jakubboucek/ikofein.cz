application:
    errorPresenter: Error
    mapping:
        *: App\*Module\Presenters\*Presenter

session:
    expiration: 14 days

mail:
    smtp: true
    host: maildev
    port: 1025

database:
    dsn: 'mysql:host=mysqldb;dbname=default;charset=utf8'
    user: root
    password: devstack
    options:
        lazy: TRUE

di:
    debugger: false

http:
    csp:
        script-src:
            - 'strict-dynamic'
            - 'nonce'
            - 'unsafe-inline'   # csp-2 fallback
            - 'http:'           # csp-2 fallback
            - 'https:'          # csp-2 fallback
        frame-ancestors: none
        frame-src:
            - self
            - https://www.googletagmanager.com/
            - https://www.google.com/   # google maps
        form-action: self
        object-src: none
        style-src:
            - self
            - 'https://maxcdn.bootstrapcdn.com'
            - 'https://cdn.tiny.cloud'
            - 'unsafe-inline' # because wysiwyg editor
        base-uri: none

tracy:
    fromEmail: noreply@ikofein.cz

services:
    - JakubBoucek\Hydrator\HydratorFactory(JakubBoucek\Hydrator\Format\NetteDatabase)
    - App\Model\PostManager
    - App\Model\WebDir(%wwwDir%)
    - App\Model\PasswordReset
    postRenderer: App\Component\PostRenderer
    router: App\Router\RouterFactory::createRouter
    authenticator: App\Model\UserManager
