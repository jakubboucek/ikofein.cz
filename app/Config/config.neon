application:
    errorPresenter:
        4xx: Error:Error4xx
        5xx: Error:Error5xx
    mapping: App\Presenters\*\**Presenter

assets:
    mapping:
        default:
            type: vite
            path: assets

session:
    expiration: 14 days

mail:
    smtp: true
    host: maildev
    port: 1025

database:
    dsn: 'mysql:host=mysqldb;dbname=default;charset=utf8'
    user: root
    password: devstack
    options:
        lazy: TRUE

di:
    debugger: false

http:
    csp:
        script-src:
            - 'strict-dynamic'
            - 'nonce'
        frame-ancestors: none
        frame-src:
            - self
            - https://www.google.com/   # google maps
        form-action: self
        object-src: none
        style-src:
            - self
            - 'unsafe-inline' # because wysiwyg editor
        base-uri: none

tracy:
    fromEmail: noreply@ikofein.cz

services:
    - JakubBoucek\Hydrator\HydratorFactory(JakubBoucek\Hydrator\Format\NetteDatabase)
    - App\Model\PostManager
    - App\Model\PasswordReset
    postRenderer: App\Component\PostRenderer
    router: App\Router\RouterFactory::createRouter
    authenticator: App\Model\UserManager
